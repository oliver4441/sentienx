# Sentienx Environment Configuration
# Deriv API credentials - register at https://developers.deriv.com/

# Your Deriv app ID (from https://developers.deriv.com)
DERIV_APP_ID=

# Your affiliate/referral token from https://deriv.com/partners
# Include this to earn commission on every user you refer
DERIV_AFFILIATE_TOKEN=YOUR_AFFILIATE_TOKEN_HERE

# OAuth redirect URI - must match exactly what's registered in your Deriv app
DERIV_REDIRECT_URI=https://sentienx.com/api/auth/deriv/callback

# Markup percentage (0-3%) - earns commission on every trade your users make
DERIV_MARKUP=0

# Base URL
BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development
