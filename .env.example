# Sentienx Environment Configuration

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Deriv API ────────────────────────────────────────────────────────
# Your Deriv app ID (from https://developers.deriv.com)
DERIV_APP_ID=113241

# Partner referral token — the `sidc` value from your Deriv Partners referral link
# Use ONE of these:
# Revenue Share: 2548C893-FA83-40F4-B2DE-23CA0323E77A
# Turnover:     9A0642DD-82D8-4247-B788-BB1E6E1F9392
# Master:       8D84947E-BB36-47A7-A09E-2FD6E49F682A
# MyAffiliate:  nXuHksD9Gfb1hit6RV3zsGNd7ZgqdRLk
DERIV_AFFILIATE_TOKEN=2548C893-FA83-40F4-B2DE-23CA0323E77A

# OAuth redirect URI — must match exactly what's registered in your Deriv app
DERIV_REDIRECT_URI=https://sentienx.com/api/auth/deriv/callback

# Markup percentage (0-3%) — earns commission on every trade
DERIV_MARKUP=1.5

# ─── Neon Postgres ───────────────────────────────────────────────────
# Connection string from Neon dashboard (https://console.neon.tech)
# Format: postgres://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.neon.tech/sentienx?sslmode=require

# ─── Composio ────────────────────────────────────────────────────────
# API key from https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here
